# ------------------------------------------------------------------
# LaoLearn backend - environment variables
#
# Used when you run the API directly (npm run dev). Under Docker the
# values come from the root .env via docker-compose.yml instead.
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=9000

# Set to 1 when the API runs behind a reverse proxy (nginx, Docker, Render...)
# so that rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=0

# --- Database -----------------------------------------------------
# Local (npm run dev):     postgres://laolearn:laolearn@localhost:5432/laolearn
# Inside docker compose:   postgres://laolearn:laolearn@db:5432/laolearn
DATABASE_URL=postgres://laolearn:laolearn@localhost:5432/laolearn

# --- Auth ---------------------------------------------------------
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12

# Optional safety net for a real school: when set, anyone registering as a
# teacher must also type this code. Leave empty to allow open teacher signup.
TEACHER_REGISTRATION_CODE=

# --- Rate limits (per IP) -----------------------------------------
# A whole class usually shares one school NAT gateway, so every student looks
# like the same IP. Limits tight enough to stop one laptop guessing passwords
# would lock out a class of forty, so these default generously.
RATE_LIMIT_LOGIN_MAX=100
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_REGISTER_MAX=60
RATE_LIMIT_REGISTER_WINDOW_MIN=60

# --- CORS ---------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

# --- First admin account (used by `npm run seed`) -----------------
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@laolearn.la
ADMIN_PASSWORD=

# --- Cloudinary (wired up in a later step, for lesson attachments) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
