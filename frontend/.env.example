# The frontend normally calls the API through a same-origin "/api" path:
# in development Vite proxies it, in production nginx proxies it.
# Only set this if the API lives on a completely different domain.
# VITE_API_URL=https://api.example.la/api

# Where `npm run dev` should forward /api requests.
VITE_API_PROXY=http://localhost:9000
