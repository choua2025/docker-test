# ------------------------------------------------------------------
# Root .env - read by `docker compose`.
# Copy to `.env` and fill in. NEVER commit `.env`.
# (backend/.env is separate: it is for running the API without Docker.)
# ------------------------------------------------------------------

POSTGRES_USER=laolearn
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=laolearn

# REQUIRED. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Optional: when set, teacher registration requires this code.
TEACHER_REGISTRATION_CODE=

# Where the browser loads the site from (used for CORS).
CORS_ORIGIN=http://localhost:8081

# First admin account, created by: docker compose run --rm backend npm run seed
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@laolearn.la
ADMIN_PASSWORD=

# Host ports (changed from the usual 5432/9000/8080 because other
# containers on this machine already use them).
POSTGRES_HOST_PORT=5440
BACKEND_HOST_PORT=9010
FRONTEND_HOST_PORT=8081

# Cloudinary - lesson attachments (PDF / video / image).
# Get these from cloudinary.com -> Dashboard. Leave empty to disable upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=laolearn
UPLOAD_MAX_MB=100

# Rate limits per IP. Raise these if a whole class shares one connection.
RATE_LIMIT_LOGIN_MAX=100
RATE_LIMIT_REGISTER_MAX=60
